# Pinned tool versions. Single source of truth for every runtime the toolkit
# targets (hosted runner today; the GHCR Dockerfile's input later — ADR 0002).
# Shell-sourceable and Dockerfile-ARG-compatible: KEY=value, no spaces, no quotes.

CLAUDE_CODE_VERSION=2.1.212

# Pinned for reproducibility even though hosted runners preinstall both.
GH_VERSION=2.63.2
JQ_VERSION=1.7.1

# YAML reader for .smallhours.yml — jq cannot parse YAML, and a hand-rolled
# parser is fragile on the nested config maps. Single static binary; portable to
# the future self-hosted image and GitLab. See ADR 0004.
YQ_VERSION=4.53.3
